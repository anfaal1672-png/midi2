{
  "name": "midi2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-preact": "^1.49.0",
    "preact": "^10.29.8",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.145.0"
  },
  "description": "\u8d85\u9ad8\u6a5f\u80fd MIDI \u30d7\u30ec\u30a4\u30e4\u30fc (Web)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/check-pages.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:pages": "node scripts/check-pages.mjs",
    "gen:demo": "node scripts/gen-demo.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=${CF_PAGES_PROJECT:-midi2}"
  }
}
